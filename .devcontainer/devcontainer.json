// See https://aka.ms/devcontainer.json for format details.
{
  "name": "Doenet Apps",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/home/node/workspace",
  "remoteUser": "node",

  // The base image is a slim Node image with no SSH server, which the
  // `gh codespace ssh|logs|cp` commands need. Harmless locally.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  // api, app (open this one), blog
  "forwardPorts": [3000, 8000, 4321],
  "portsAttributes": {
    "3000": { "label": "api" },
    "8000": { "label": "app", "onAutoForward": "notify" },
    "4321": { "label": "blog" }
  },

  // Runs on the host before the container is created. Docker creates a missing
  // volume mount point as root, which would leave root-owned directories in the
  // checkout that host-side npm cannot write to; creating them first as the
  // host user avoids that.
  "initializeCommand": "mkdir -p node_modules apps/api/node_modules apps/app/node_modules apps/web/node_modules",

  // Passes an API key through when the host has one set. Claude Code also
  // signs in interactively with `claude`, and Codespaces exposes a repository
  // or user secret of this name automatically.
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Stop MySQL and s3mock along with the dev container.
  "shutdownAction": "stopCompose",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "vitest.explorer",
        "astro-build.astro-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
